NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=
# HTTPS endpoint accepting JSON; must return a 2xx only after durably accepting the enquiry.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
# Public HTTPS endpoint that applies server-side validation and rate limiting.
# Leave blank until it is deployed; the site will show a clear unavailable state.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
# Optional shared Redis REST service for multi-instance rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
# Keep false until legal drafts have been professionally reviewed and launch configuration completed.
PUBLIC_LAUNCH_READY=false
